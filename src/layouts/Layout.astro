---
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = "MotivPro Group | Global Mobility Experts" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="MotivPro Group — Curated global journeys, visa assistance, and seamless travel experiences from Accra, Ghana." />
		<title>{title}</title>
	</head>
	<body>
		<!-- Partnership Announcement Banner -->
		<div id="partnership-banner" class="fixed top-0 left-0 right-0 z-[60] bg-gradient-to-r from-[#1e1b4b] via-[#312e81] to-[#1e1b4b] relative overflow-hidden">
			<!-- Subtle pattern overlay -->
			<div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,%3Csvg width=%2220%22 height=%2220%22 viewBox=%220 0 20 20%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Ccircle cx=%221%22 cy=%221%22 r=%221%22 fill=%22white%22/%3E%3C/svg%3E');"></div>
			<div class="flex items-center justify-center py-3 px-12 relative z-10">
				<div class="flex items-center gap-3 md:gap-4">
					<span class="hidden sm:inline-flex items-center justify-center w-7 h-7 rounded-full bg-white/10 backdrop-blur-sm">
						<svg class="w-4 h-4 text-indigo-300" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
					</span>
					<p class="text-white text-[11px] md:text-xs font-medium tracking-wide">
						<span class="font-bold">Proud ISFIT Partner</span>
						<span class="mx-2 text-white/30">|</span>
						<span class="text-white/70">Empowering global education together</span>
					</p>
					<a href="/discover" class="inline-flex items-center gap-1.5 bg-indigo-500/30 hover:bg-indigo-500/50 backdrop-blur-sm text-white text-[11px] md:text-xs font-semibold px-4 py-1.5 rounded-full transition-all duration-300 ml-2 border border-indigo-400/20">
						Discover
						<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
					</a>
				</div>
			</div>
			<button
				id="close-banner"
				class="absolute right-3 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-all duration-200 group"
				aria-label="Close banner"
			>
				<svg class="w-3.5 h-3.5 text-white/50 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
			</button>
		</div>

		<!-- Spacer for fixed banner -->
		<div class="h-11"></div>

		<slot />

		<script>
			const banner = document.getElementById("partnership-banner");
			const closeBtn = document.getElementById("close-banner");

			closeBtn?.addEventListener("click", () => {
				banner?.classList.add("hidden");
			});
		</script>

		<script>
			// Smooth scroll for anchor links
			document.querySelectorAll('a[href^="#"]').forEach(anchor => {
				anchor.addEventListener('click', function (this: HTMLElement, e: Event) {
					e.preventDefault();
					const href = this.getAttribute('href');
					if (href) {
						const target = document.querySelector(href);
						if (target) {
							target.scrollIntoView({
								behavior: 'smooth',
								block: 'start'
							});
						}
					}
				});
			});
		</script>
	</body>
</html>
