---
import workshopBg from "../assets/isfit_workshop/photo_2026-06-11_11-10-21.jpg";
---

<section
    id="discover-hero"
    class="relative min-h-screen flex items-center justify-center overflow-hidden bg-primary"
>
    <!-- Multi-layer background -->
    <div class="absolute inset-0 z-0">
        <img
            src={workshopBg.src}
            alt=""
            class="absolute inset-0 w-full h-full object-cover opacity-30"
            style="object-position: center 20%;"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-primary/60 via-primary/40 to-primary"></div>
        <!-- Grain texture -->
        <div class="absolute inset-0 opacity-[0.04] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
    </div>

    <!-- Floating decorative elements -->
    <div class="absolute top-1/3 left-[15%] w-24 h-24 border border-white/10 rounded-full"></div>
    <div class="absolute bottom-1/4 right-[10%] w-16 h-16 border border-accent-indigo/20 rounded-full"></div>

    <!-- Main content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center text-white pt-32 pb-20">
        <!-- Eyebrow -->
        <div class="mb-8">
            <span
                class="inline-block py-2 px-6 rounded-full bg-white/5 border border-white/10 text-[10px] font-bold tracking-[0.4em] uppercase text-white/60 backdrop-blur-sm"
            >
                Discover
            </span>
        </div>

        <!-- Large masked text heading -->
        <div class="mb-8 md:mb-12">
            <h1
                class="text-7xl sm:text-8xl md:text-9xl lg:text-[11rem] font-bold leading-[0.8] tracking-tighter text-mask-image"
                style="font-family: var(--font-heading);"
            >
                Explore
            </h1>
            <h1
                class="text-7xl sm:text-8xl md:text-9xl lg:text-[11rem] font-bold leading-[0.8] tracking-tighter text-white/80"
                style="font-family: var(--font-heading);"
            >
                The World
            </h1>
        </div>

        <!-- Description -->
        <div class="mb-12">
            <p
                class="text-lg md:text-xl text-white/50 max-w-2xl mx-auto leading-relaxed font-light"
            >
                Explore our curated experiences, workshop highlights, and the journeys that shape global leaders.
            </p>
        </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10">
        <div class="flex flex-col items-center gap-3">
            <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-white/30">Scroll</span>
            <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent"></div>
        </div>
    </div>
</section>

<style>
    .text-mask-image {
        background-image: url('/service_corporate_tours.png');
        background-size: cover;
        background-position: center;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>
