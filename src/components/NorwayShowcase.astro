---
const images = [
    { src: "/norwegian_ambassador/WhatsApp%20Image%202026-07-15%20at%2023.09.31%20%281%29.jpeg", alt: "ISFiT Norway Partnership Event" },
    { src: "/norwegian_ambassador/WhatsApp%20Image%202026-07-15%20at%2023.09.31.jpeg", alt: "Norway Partnership Announcement" },
    { src: "/norwegian_ambassador/WhatsApp%20Image%202026-07-15%20at%2023.09.32%20%281%29.jpeg", alt: "Travel Logistics Provider ISFiT" },
    { src: "/norwegian_ambassador/WhatsApp%20Image%202026-07-15%20at%2023.09.32.jpeg", alt: "Ghana Students Norway Festival" },
    { src: "/norwegian_ambassador/WhatsApp%20Image%202026-07-15%20at%2023.09.33.jpeg", alt: "MotivPro Norway Partnership" },
];

// Norwegian flag CSS (low opacity overlay)
// Red: #EF2B2D, Blue: #00205B, White: #FFFFFF
const flagBackground = `
    background-color: #EF2B2D;
    background-image:
        /* Vertical blue cross */
        linear-gradient(to right, transparent 25%, #00205B 25%, #00205B 30%, transparent 30%),
        /* Horizontal blue cross */
        linear-gradient(to bottom, transparent 38%, #00205B 38%, #00205B 48%, transparent 48%),
        /* Vertical white border */
        linear-gradient(to right, transparent 23%, #FFFFFF 23%, #FFFFFF 25%, transparent 25%, transparent 30%, #FFFFFF 30%, #FFFFFF 32%, transparent 32%),
        /* Horizontal white border */
        linear-gradient(to bottom, transparent 36%, #FFFFFF 36%, #FFFFFF 38%, transparent 38%, transparent 48%, #FFFFFF 48%, #FFFFFF 50%, transparent 50%);
`;
---

<section class="relative py-16 md:py-32 overflow-hidden" id="norway">
    <!-- Norwegian flag background -->
    <div class="absolute inset-0 opacity-20" style={flagBackground}></div>
    
    <!-- Content overlay to ensure readability -->
    <div class="absolute inset-0 bg-gradient-to-b from-background/50 via-transparent to-background/50"></div>

    <div class="relative z-10">
        <!-- Section header -->
        <div class="max-w-6xl mx-auto px-6 mb-12 md:mb-20">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <span class="text-[10px] uppercase tracking-[0.4em] text-text-muted font-semibold block mb-4">Featured Partnership</span>
                    <h2 class="text-5xl md:text-7xl lg:text-8xl leading-[0.85] tracking-tight">
                        <span class="serif-italic">Norway.</span>
                    </h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-sm text-text-muted font-light leading-relaxed">
                        Official Travel Logistics Provider for ISFiT Norway — Empowering Ghanaian students on the global stage.
                    </p>
                </div>
            </div>
        </div>

        <!-- Parallax image grid -->
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
                <!-- Large featured image — tall left column -->
                <div class="md:col-span-7 relative overflow-hidden rounded-xl group">
                    <div class="aspect-[3/4] md:aspect-[4/5]">
                        <img
                            src={images[0].src}
                            alt={images[0].alt}
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <div class="absolute bottom-6 left-6 text-white opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-4 group-hover:translate-y-0">
                        <span class="text-[10px] uppercase tracking-[0.3em] font-semibold block mb-1">Trondheim, Norway</span>
                        <span class="text-2xl font-bold" style="font-family: var(--font-serif);">ISFiT 2026</span>
                    </div>
                </div>

                <!-- Right column — stacked images -->
                <div class="md:col-span-5 flex flex-col gap-4 md:gap-6">
                    <div class="relative overflow-hidden rounded-xl group flex-1">
                        <div class="aspect-[4/3]">
                            <img
                                src={images[1].src}
                                alt={images[1].alt}
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    </div>

                    <div class="relative overflow-hidden rounded-xl group flex-1">
                        <div class="aspect-[4/3]">
                            <img
                                src={images[2].src}
                                alt={images[2].alt}
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    </div>
                </div>
            </div>

            <!-- Bottom row — two equal tall images -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mt-4 md:mt-6">
                <div class="relative overflow-hidden rounded-xl group">
                    <div class="aspect-[3/4]">
                        <img
                            src={images[3].src}
                            alt={images[3].alt}
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                </div>

                <div class="relative overflow-hidden rounded-xl group">
                    <div class="aspect-[3/4]">
                        <img
                            src={images[4].src}
                            alt={images[4].alt}
                            class="w-full h-full object-cover"
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <div class="absolute bottom-6 right-6 text-right text-white opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-4 group-hover:translate-y-0">
                        <span class="text-[10px] uppercase tracking-[0.3em] font-semibold block mb-1">Explore</span>
                        <a href="https://participant.isfit.no/" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold border-b border-white/40 pb-0.5 hover:border-white transition-colors">Apply to ISFiT &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom text -->
        <div class="max-w-6xl mx-auto px-6 mt-16 md:mt-20">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
                <p class="text-xl md:text-2xl text-primary/70 font-light leading-relaxed">
                    From Accra to Trondheim — <span class="serif-italic text-primary">bridging continents through education and opportunity.</span>
                </p>
                <div class="flex justify-start md:justify-end">
                    <a href="/consultation" class="magnetic-btn inline-flex items-center gap-4 text-sm font-semibold uppercase tracking-wider group">
                        <span>Book a Consultation</span>
                        <span class="w-12 h-px bg-primary group-hover:w-20 transition-all duration-500"></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
