---
import heroImg from "../assets/isfit_workshop/photo_2026-06-11_11-10-24.jpg";
---

<section
    id="hero"
    class="relative min-h-screen flex items-center justify-center overflow-hidden bg-primary"
>
    <!-- Background -->
    <div class="absolute inset-0 z-0">
        <img
            src={heroImg.src}
            alt=""
            class="absolute inset-0 w-full h-full object-cover opacity-20"
        />
        <div class="absolute inset-0 bg-gradient-to-br from-primary/40 via-transparent to-primary/60"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/50 to-transparent"></div>
        <!-- Grain overlay -->
        <div class="absolute inset-0 opacity-[0.03] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');"></div>
    </div>

    <!-- Floating decorative elements -->
    <div class="absolute top-1/4 left-8 w-px h-32 bg-gradient-to-b from-transparent via-white/20 to-transparent"></div>
    <div class="absolute bottom-1/4 right-8 w-px h-48 bg-gradient-to-b from-transparent via-white/15 to-transparent"></div>
    <div class="absolute top-1/3 right-1/4 w-2 h-2 rounded-full bg-accent-indigo/40"></div>

    <!-- Main content -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center text-white pt-32 pb-20">
        <!-- Eyebrow text -->
        <div class="mb-8">
            <span
                class="inline-block py-2 px-6 rounded-full bg-white/5 border border-white/10 text-[10px] font-bold tracking-[0.4em] uppercase text-white/60 backdrop-blur-sm"
            >
                Motiv Pro Group
            </span>
        </div>

        <!-- Main heading -->
        <div class="mb-8 md:mb-12">
            <h1
                class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-bold leading-[0.85] tracking-tighter mb-2"
                style="font-family: var(--font-heading);"
            >
                <span class="block">Travel</span>
            </h1>
            <h1
                class="text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-bold leading-[0.85] tracking-tighter"
                style="font-family: var(--font-heading);"
            >
                <span class="block">&</span>
                <span class="block serif-italic text-white/70">Tour.</span>
            </h1>
        </div>

        <!-- Description -->
        <div class="mb-12">
            <p
                class="text-lg md:text-xl text-white/50 max-w-2xl mx-auto leading-relaxed font-light"
            >
                Expert logistical support and seamless planning for every type of
                journey. Whether for leisure, education, or corporate objectives, we
                ensure your travel is extraordinary.
            </p>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row justify-center gap-4 sm:gap-6">
            <a
                href="/#services"
                class="group inline-flex items-center justify-center gap-3 bg-white text-primary px-8 py-4 rounded-full font-semibold text-sm transition-all duration-300 hover:shadow-2xl hover:shadow-white/20"
            >
                <span>Explore Services</span>
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
                </svg>
            </a>
            <a
                href="/consultation"
                class="group inline-flex items-center justify-center gap-3 border border-white/20 bg-white/5 backdrop-blur-sm text-white hover:bg-white hover:text-primary px-8 py-4 rounded-full font-medium text-sm transition-all duration-300"
            >
                <span>Book a Consultation</span>
            </a>
        </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10">
        <div class="flex flex-col items-center gap-3">
            <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-white/30">Scroll</span>
            <div class="w-px h-12 bg-gradient-to-b from-white/30 to-transparent"></div>
        </div>
    </div>

    <!-- Side text -->
    <div class="hidden lg:block absolute left-8 top-1/2 -translate-y-1/2 z-10">
        <span class="text-[9px] font-bold tracking-[0.3em] uppercase text-white/20 [writing-mode:vertical-lr] rotate-180">
            Explore the World
        </span>
    </div>
</section>
