---
const whyTravel = [
    {
        title: "Aviation & Industry Expertise",
        description:
            "We know the global travel industry from the inside out, passing our logistical knowledge directly to you.",
        icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
    },
    {
        title: "Precision Planning",
        description:
            "We double-check every booking, routing, and requirement so you never have to worry about the details.",
        icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>',
    },
    {
        title: "Client-First Support",
        description:
            "Your peace of mind is our top priority. We are with you from your first inquiry until you arrive safely back home.",
        icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
    },
];

const stats = [
    { value: "500+", label: "Trips Planned" },
    { value: "98%", label: "Satisfaction Rate" },
    { value: "24/7", label: "Support Available" },
];
---

<section class="py-24 md:py-40 bg-background relative overflow-hidden">
    <!-- Asymmetric Bento Grid -->
    <div class="max-w-7xl mx-auto px-6 mb-24 md:mb-32">
        <div class="grid lg:grid-cols-12 gap-6 md:gap-8">
            <!-- Large feature card -->
            <div class="lg:col-span-7 group" data-reveal="clip">
                <div class="relative bg-primary rounded-[2rem] p-10 md:p-14 h-full overflow-hidden transition-all duration-700 hover:shadow-2xl hover:shadow-primary/20">
                    <!-- Background pattern -->
                    <div class="absolute inset-0 opacity-5">
                        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
                    </div>
                    <!-- Accent glow -->
                    <div class="absolute -top-32 -right-32 w-64 h-64 bg-accent-orange/20 rounded-full blur-[100px] transition-opacity duration-700 opacity-0 group-hover:opacity-100"></div>
                    
                    <div class="relative z-10">
                        <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-white/40 mb-6 block">
                            Why Choose Us
                        </span>
                        <h2
                            class="text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-[0.9] mb-8"
                            style="font-family: var(--font-heading);"
                        >
                            The Motiv Pro<br />
                            <span class="serif-italic text-accent-orange">Advantage.</span>
                        </h2>
                        <p class="text-white/50 font-light leading-relaxed max-w-md mb-12">
                            Precision planning and industry expertise that transforms every journey into a masterpiece.
                        </p>
                        
                        <!-- Stats -->
                        <div class="grid grid-cols-3 gap-6">
                            {stats.map((stat) => (
                                <div class="text-center">
                                    <div class="text-3xl md:text-4xl font-bold text-white mb-2" style="font-family: var(--font-heading);">
                                        {stat.value}
                                    </div>
                                    <div class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">
                                        {stat.label}
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Stacked feature cards -->
            <div class="lg:col-span-5 flex flex-col gap-6 md:gap-8">
                {whyTravel.map((reason, index) => (
                    <div class="group flex-1" data-reveal="clip">
                        <div class="relative bg-grey-bg rounded-[2rem] p-8 md:p-10 h-full overflow-hidden transition-all duration-700 hover:bg-white hover:shadow-xl hover:shadow-black/5">
                            <!-- Hover accent -->
                            <div class="absolute bottom-0 left-0 w-full h-1 bg-accent-orange transform scale-x-0 origin-left transition-transform duration-700 group-hover:scale-x-100"></div>
                            
                            <div class="relative z-10 flex items-start gap-6">
                                <div
                                    class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center text-primary flex-shrink-0 transition-all duration-500 group-hover:bg-accent-orange group-hover:text-white group-hover:rotate-3"
                                    set:html={reason.icon}
                                />
                                <div>
                                    <h3 class="text-xl font-bold text-primary mb-3 tracking-tight" style="font-family: var(--font-heading);">
                                        {reason.title}
                                    </h3>
                                    <p class="text-text-muted font-light leading-relaxed text-sm">
                                        {reason.description}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>

    <!-- Full-width marquee -->
    <div class="relative overflow-hidden py-12 border-y border-primary/10">
        <div class="marquee-row">
            <div class="flex gap-8 items-center animate-marquee whitespace-nowrap">
                {[...Array(3)].map(() => (
                    <span class="text-6xl md:text-8xl font-bold text-primary/[0.03] tracking-tighter" style="font-family: var(--font-heading);">
                        Travel & Tour
                    </span>
                    <span class="text-accent-orange/20 text-4xl">•</span>
                ))}
            </div>
            <div class="flex gap-8 items-center animate-marquee whitespace-nowrap" aria-hidden="true">
                {[...Array(3)].map(() => (
                    <span class="text-6xl md:text-8xl font-bold text-primary/[0.03] tracking-tighter" style="font-family: var(--font-heading);">
                        Travel & Tour
                    </span>
                    <span class="text-accent-orange/20 text-4xl">•</span>
                ))}
            </div>
        </div>
    </div>

    <!-- Bottom text -->
    <div class="max-w-7xl mx-auto px-6 pt-24 md:pt-32">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <p class="text-2xl md:text-3xl text-primary/70 font-light leading-relaxed" data-reveal="fade">
                Expert logistical support that transforms every journey into a <span class="serif-italic text-primary">masterpiece of precision.</span>
            </p>
            <div class="flex justify-start lg:justify-end" data-reveal="fade">
                <a href="/#contact" class="magnetic-btn group inline-flex items-center gap-4 text-sm font-semibold uppercase tracking-wider text-accent-orange">
                    <span>Start Planning</span>
                    <span class="w-12 h-px bg-accent-orange group-hover:w-20 transition-all duration-500"></span>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes marquee {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-100%);
        }
    }
    
    .animate-marquee {
        animation: marquee 30s linear infinite;
    }
</style>
