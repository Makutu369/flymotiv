---
const services = [
    {
        number: "01",
        title: "FIT",
        subtitle: "Fully Independent Travel",
        description:
            "For the traveler who wants complete freedom without the hassle of planning. We design highly customized, self-guided itineraries tailored precisely to your personal pace, budget, and interests.",
        image: "/service_travel_protocol.png"
    },
    {
        number: "02",
        title: "Study Missions",
        subtitle: "Cultural Exchanges",
        description:
            "International education requires precise coordination. We provide specialized travel planning for academic institutions, organizations, and cultural groups with group visa guidance and ground transport.",
        image: "/service_corporate_tours.png"
    },
    {
        number: "03",
        title: "Business Trips",
        subtitle: "Corporate Travel",
        description:
            "In corporate travel, efficiency and reliability are everything. We provide streamlined travel management for executives, entrepreneurs, and corporate teams with optimal flight schedules and premium accommodations.",
        image: "/service_study_abroad.png"
    },
    {
        number: "04",
        title: "Tourism",
        subtitle: "Leisure & Adventure",
        description:
            "Your time off should be stress-free. Whether you are looking for a relaxing holiday, a vibrant city break, or an adventurous international getaway, we curate memorable tourism experiences.",
        image: "/hero_background.png"
    },
    {
        number: "05",
        title: "Group Tours",
        subtitle: "Travel Together",
        description:
            "Travel is better together. We take the lead on comprehensive group tours for large families, friend groups, and social organizations with group flight rates and coordinated ground transportation.",
        image: "/service_corporate_tours.png"
    },
];
---

<section class="py-24 md:py-40 bg-primary relative overflow-hidden" id="services">
    <!-- Section header -->
    <div class="max-w-7xl mx-auto px-6 mb-16 md:mb-24">
        <div class="grid lg:grid-cols-2 gap-12 items-end">
            <div>
                <span class="text-[10px] font-bold uppercase tracking-[0.4em] text-white/40 block mb-6" data-reveal="fade">
                    Service Portfolio
                </span>
                <h2
                    class="text-5xl md:text-6xl lg:text-8xl font-bold leading-[0.85] tracking-tight text-white"
                    style="font-family: var(--font-heading);"
                    data-reveal="fade"
                >
                    What We<br />
                    <span class="serif-italic text-white/60">Offer.</span>
                </h2>
            </div>
            <div class="lg:pb-4" data-reveal="fade">
                <p class="text-lg text-white/40 font-light leading-relaxed max-w-md">
                    Expert logistical support and seamless planning for leisure,
                    education, or corporate objectives.
                </p>
            </div>
        </div>
    </div>

    <!-- Horizontal scroll container -->
    <div class="horizontal-scroll-wrapper relative" id="horizontal-scroll">
        <div class="horizontal-scroll-track flex gap-6 md:gap-8 pl-6 md:pl-12 pr-[30vw]">
            {services.map((service, index) => (
                <div
                    class="horizontal-scroll-card flex-shrink-0 w-[85vw] md:w-[60vw] lg:w-[45vw] group"
                    data-reveal="fade"
                >
                    <div class="relative bg-white/5 rounded-3xl p-8 md:p-10 border border-white/10 h-full transition-all duration-700 hover:bg-white/10 hover:border-white/20">
                        <!-- Number -->
                        <span class="text-[80px] md:text-[120px] font-bold text-white/[0.03] leading-none absolute top-4 right-6 md:top-6 md:right-8" style="font-family: var(--font-heading);">
                            {service.number}
                        </span>
                        
                        <!-- Content -->
                        <div class="relative z-10">
                            <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-accent-orange mb-4 block">
                                {service.subtitle}
                            </span>
                            <h3
                                class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 tracking-tight"
                                style="font-family: var(--font-heading);"
                            >
                                {service.title}
                            </h3>
                            <p class="text-white/50 font-light leading-relaxed mb-10 max-w-md">
                                {service.description}
                            </p>
                            
                            <a
                                href="/#contact"
                                class="inline-flex items-center gap-4 text-xs font-bold uppercase tracking-[0.2em] text-white group/link"
                            >
                                <span>Learn More</span>
                                <span class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center transition-all duration-500 group-hover/link:bg-white group-hover/link:text-primary">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                    </svg>
                                </span>
                            </a>
                        </div>

                        <!-- Image preview on hover -->
                        <div class="absolute bottom-0 right-0 w-1/3 h-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-700 overflow-hidden rounded-tr-3xl rounded-bl-3xl">
                            <img
                                src={service.image}
                                alt={service.title}
                                class="w-full h-full object-cover"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent"></div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>

    <!-- Scroll progress indicator -->
    <div class="max-w-7xl mx-auto px-6 mt-16 md:mt-24">
        <div class="flex items-center gap-4">
            <div class="h-px flex-1 bg-white/10 relative overflow-hidden">
                <div id="scroll-progress" class="absolute top-0 left-0 h-full bg-accent-orange transition-all duration-300" style="width: 0%"></div>
            </div>
            <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-white/30">Scroll to explore</span>
        </div>
    </div>
</section>

<style>
    .horizontal-scroll-wrapper {
        overflow: hidden;
    }
    
    .horizontal-scroll-track {
        transition: transform 0.1s ease-out;
    }
</style>

<script>
    import { animate, scroll, inView } from "motion";

    // Horizontal scroll on vertical scroll
    const scrollContainer = document.getElementById('horizontal-scroll');
    const scrollTrack = document.querySelector<HTMLElement>('.horizontal-scroll-track');
    const progressBar = document.getElementById('scroll-progress');
    
    if (scrollContainer && scrollTrack) {
        let ticking = false;
        
        function updateHorizontalScroll() {
            const rect = scrollContainer.getBoundingClientRect();
            const scrollHeight = scrollContainer.offsetHeight - window.innerHeight;
            const scrolled = -rect.top;
            
            if (scrolled >= 0 && scrolled <= scrollHeight) {
                const maxScroll = scrollTrack.scrollWidth - window.innerWidth;
                const progress = scrolled / scrollHeight;
                const translateX = -progress * maxScroll;
                
                scrollTrack.style.transform = `translateX(${translateX}px)`;
                
                if (progressBar) {
                    progressBar.style.width = `${progress * 100}%`;
                }
            }
            
            ticking = false;
        }
        
        window.addEventListener('scroll', () => {
            if (!ticking) {
                requestAnimationFrame(updateHorizontalScroll);
                ticking = true;
            }
        }, { passive: true });
    }
</script>
