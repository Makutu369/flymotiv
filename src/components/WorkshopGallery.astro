---
import workshop1 from "../assets/isfit_workshop/photo_2026-06-11_11-10-21.jpg";
import workshop2 from "../assets/isfit_workshop/photo_2026-06-11_11-10-24.jpg";
import workshop3 from "../assets/isfit_workshop/photo_2026-06-11_11-10-27.jpg";
import workshop4 from "../assets/isfit_workshop/photo_2026-06-11_11-10-29.jpg";
import workshop5 from "../assets/isfit_workshop/photo_2026-06-11_11-10-31.jpg";
import workshop6 from "../assets/isfit_workshop/photo_2026-06-11_11-10-33.jpg";
import workshop7 from "../assets/isfit_workshop/photo_2026-06-11_11-10-36.jpg";
import workshop8 from "../assets/isfit_workshop/photo_2026-06-11_11-10-38.jpg";
import workshop9 from "../assets/isfit_workshop/photo_2026-06-11_11-10-41.jpg";
import workshop10 from "../assets/isfit_workshop/photo_2026-06-11_11-10-43.jpg";
import workshop11 from "../assets/isfit_workshop/photo_2026-06-11_11-10-46.jpg";
import workshop12 from "../assets/isfit_workshop/photo_2026-06-11_11-10-48.jpg";
import workshop13 from "../assets/isfit_workshop/photo_2026-06-11_11-10-49.jpg";
import workshop14 from "../assets/isfit_workshop/photo_2026-06-11_11-10-51.jpg";
import workshop15 from "../assets/isfit_workshop/photo_2026-06-11_11-10-54.jpg";

const images = [
    { src: workshop1.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop2.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop3.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop4.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop5.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop6.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop7.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop8.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop9.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop10.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop11.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop12.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop13.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop14.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop15.src, alt: "ISFiT 2025 Workshop" },
];

const categories = ["All", "Workshops", "Cultural", "Networking", "Leadership"];
---

<section class="py-24 md:py-40 bg-background overflow-hidden" id="workshop">
    <!-- Section header -->
    <div class="max-w-7xl mx-auto px-6 mb-16 md:mb-24">
        <div class="grid lg:grid-cols-12 gap-8 items-end">
            <div class="lg:col-span-8">
                <span class="text-[10px] font-bold uppercase tracking-[0.4em] text-text-muted block mb-6">
                    Workshop Highlights
                </span>
                <h2 class="text-6xl md:text-7xl lg:text-9xl leading-[0.8] tracking-tight">
                    <span class="serif-italic">ISFiT 2025.</span>
                </h2>
            </div>
            <div class="lg:col-span-4">
                <p class="text-lg text-text-muted font-light leading-relaxed mb-8">
                    A transformative workshop experience connecting students and professionals through travel, culture, and global perspectives.
                </p>
                <!-- Category filters -->
                <div class="flex flex-wrap gap-2">
                    {categories.map((cat, i) => (
                        <button
                            class={`px-4 py-2 rounded-full text-xs font-semibold tracking-wider transition-all duration-300 ${i === 0 ? 'bg-primary text-white' : 'bg-grey-bg text-text-muted hover:bg-primary hover:text-white'}`}
                        >
                            {cat}
                        </button>
                    ))}
                </div>
            </div>
        </div>
    </div>

    <!-- Creative Bento Grid -->
    <div class="max-w-7xl mx-auto px-6">
        <!-- Row 1: 2 large + 1 small -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-5">
            <!-- Large featured image -->
            <div class="md:col-span-7 relative overflow-hidden rounded-[1.5rem] group cursor-pointer">
                <div class="aspect-[4/3] md:aspect-[16/10]">
                    <img
                        src={images[0].src}
                        alt={images[0].alt}
                        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                       
                    />
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-primary/70 via-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 translate-y-8 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-700">
                    <span class="text-[10px] uppercase tracking-[0.3em] font-bold text-white/60 block mb-2">Featured</span>
                    <h3 class="text-2xl md:text-3xl font-bold text-white" style="font-family: var(--font-heading);">Opening Ceremony</h3>
                </div>
                <!-- Corner accent -->
                <div class="absolute top-6 left-6 w-12 h-12 border-l-2 border-t-2 border-white/30 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>
            
            <!-- Stacked images -->
            <div class="md:col-span-5 flex flex-col gap-4 md:gap-5">
                <div class="relative overflow-hidden rounded-[1.5rem] group cursor-pointer flex-1">
                    <div class="aspect-[4/3]">
                        <img
                            src={images[1].src}
                            alt={images[1].alt}
                            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                           
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                    <div class="absolute bottom-6 left-6 right-6 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-700">
                        <h3 class="text-xl font-bold text-white" style="font-family: var(--font-heading);">Workshop Sessions</h3>
                    </div>
                </div>
                <div class="relative overflow-hidden rounded-[1.5rem] group cursor-pointer flex-1">
                    <div class="aspect-[4/3]">
                        <img
                            src={images[2].src}
                            alt={images[2].alt}
                            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                           
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                    <div class="absolute bottom-6 left-6 right-6 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-700">
                        <h3 class="text-xl font-bold text-white" style="font-family: var(--font-heading);">Cultural Exchange</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 2: 3 equal images -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5 mt-4 md:mt-5">
            {images.slice(3, 6).map((img, i) => (
                <div class="relative overflow-hidden rounded-[1.5rem] group cursor-pointer">
                    <div class="aspect-square">
                        <img
                            src={img.src}
                            alt={img.alt}
                            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                           
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                        <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                            </svg>
                        </div>
                    </div>
                </div>
            ))}
        </div>

        <!-- Row 3: 1 tall + 2 stacked + 1 wide -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-5 mt-4 md:mt-5">
            <!-- Tall image -->
            <div class="md:col-span-4 relative overflow-hidden rounded-[1.5rem] group cursor-pointer">
                <div class="aspect-[3/4]">
                    <img
                        src={images[6].src}
                        alt={images[6].alt}
                        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                       
                    />
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-primary/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                <div class="absolute bottom-6 left-6 right-6">
                    <span class="text-[10px] uppercase tracking-[0.3em] font-bold text-white/60 block mb-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500">Day 1</span>
                    <h3 class="text-xl font-bold text-white translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-700" style="font-family: var(--font-heading);">Keynote Address</h3>
                </div>
            </div>
            
            <!-- 2 stacked images -->
            <div class="md:col-span-4 flex flex-col gap-4 md:gap-5">
                <div class="relative overflow-hidden rounded-[1.5rem] group cursor-pointer flex-1">
                    <div class="aspect-[4/3]">
                        <img
                            src={images[7].src}
                            alt={images[7].alt}
                            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                           
                        />
                    </div>
                    <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                </div>
                <div class="relative overflow-hidden rounded-[1.5rem] group cursor-pointer flex-1">
                    <div class="aspect-[4/3]">
                        <img
                            src={images[8].src}
                            alt={images[8].alt}
                            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                           
                        />
                    </div>
                    <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                </div>
            </div>

            <!-- Wide image with overlay -->
            <div class="md:col-span-4 relative overflow-hidden rounded-[1.5rem] group cursor-pointer">
                <div class="aspect-[3/4]">
                    <img
                        src={images[9].src}
                        alt={images[9].alt}
                        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                       
                    />
                </div>
                <div class="absolute inset-0 bg-gradient-to-b from-primary/30 via-transparent to-primary/70 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                <div class="absolute top-6 right-6">
                    <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 4: Full width featured -->
        <div class="mt-4 md:mt-5">
            <div class="relative overflow-hidden rounded-[2rem] group cursor-pointer">
                <div class="aspect-[21/9]">
                    <img
                        src={images[10].src}
                        alt={images[10].alt}
                        class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                       
                    />
                </div>
                <div class="absolute inset-0 bg-gradient-to-r from-primary/80 via-primary/20 to-transparent"></div>
                <div class="absolute inset-0 flex items-center">
                    <div class="p-8 md:p-16 max-w-2xl">
                        <span class="text-[10px] uppercase tracking-[0.3em] font-bold text-accent-indigo block mb-4">Featured</span>
                        <h3 class="text-3xl md:text-5xl font-bold text-white mb-4 tracking-tight" style="font-family: var(--font-heading);">
                            Global Leadership Summit
                        </h3>
                        <p class="text-white/60 font-light leading-relaxed mb-8 max-w-md">
                            Bringing together the brightest minds from around the world to shape the future of global cooperation.
                        </p>
                        <a href="#contact" class="magnetic-btn inline-flex items-center gap-4 text-xs font-bold uppercase tracking-[0.2em] text-white">
                            <span>Join Next Workshop</span>
                            <span class="w-12 h-px bg-white group-hover:w-20 transition-all duration-500"></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom CTA -->
    <div class="max-w-7xl mx-auto px-6 mt-20 md:mt-28">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <p class="text-2xl md:text-3xl text-primary/70 font-light leading-relaxed">
                Empowering the next generation of global leaders through immersive workshops and cross-cultural collaboration — <span class="serif-italic text-primary">where ideas meet the world.</span>
            </p>
            <div class="flex justify-start md:justify-end">
                <a href="#contact" class="magnetic-btn group inline-flex items-center gap-4 text-sm font-semibold uppercase tracking-wider">
                    <span>Discover Travels</span>
                    <span class="w-12 h-px bg-primary group-hover:w-20 transition-all duration-500"></span>
                </a>
            </div>
        </div>
    </div>
</section>
