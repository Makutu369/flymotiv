---
import workshop1 from "../assets/isfit_workshop/photo_2026-06-11_11-10-21.jpg";
import workshop2 from "../assets/isfit_workshop/photo_2026-06-11_11-10-24.jpg";
import workshop3 from "../assets/isfit_workshop/photo_2026-06-11_11-10-27.jpg";
import workshop4 from "../assets/isfit_workshop/photo_2026-06-11_11-10-29.jpg";
import workshop5 from "../assets/isfit_workshop/photo_2026-06-11_11-10-31.jpg";
import workshop6 from "../assets/isfit_workshop/photo_2026-06-11_11-10-33.jpg";
import workshop7 from "../assets/isfit_workshop/photo_2026-06-11_11-10-36.jpg";
import workshop8 from "../assets/isfit_workshop/photo_2026-06-11_11-10-38.jpg";
import workshop9 from "../assets/isfit_workshop/photo_2026-06-11_11-10-41.jpg";
import workshop10 from "../assets/isfit_workshop/photo_2026-06-11_11-10-43.jpg";
import workshop11 from "../assets/isfit_workshop/photo_2026-06-11_11-10-46.jpg";
import workshop12 from "../assets/isfit_workshop/photo_2026-06-11_11-10-48.jpg";
import workshop13 from "../assets/isfit_workshop/photo_2026-06-11_11-10-49.jpg";
import workshop14 from "../assets/isfit_workshop/photo_2026-06-11_11-10-51.jpg";
import workshop15 from "../assets/isfit_workshop/photo_2026-06-11_11-10-54.jpg";

const images = [
    { src: workshop1.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop2.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop3.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop4.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop5.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop6.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop7.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop8.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop9.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop10.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop11.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop12.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop13.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop14.src, alt: "ISFiT 2025 Workshop" },
    { src: workshop15.src, alt: "ISFiT 2025 Workshop" },
];
---

<section class="py-16 md:py-32 bg-background overflow-hidden" id="workshop">
    <!-- Section header -->
    <div class="max-w-6xl mx-auto px-6 mb-12 md:mb-20">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
                <span class="text-[10px] uppercase tracking-[0.4em] text-text-muted font-semibold block mb-4" data-reveal="fade">Workshop Highlights</span>
                <h2 class="text-5xl md:text-7xl lg:text-8xl leading-[0.85] tracking-tight" data-reveal="fade">
                    <span class="serif-italic">ISFiT 2025.</span>
                </h2>
            </div>
            <div class="max-w-xs" data-reveal="fade">
                <p class="text-sm text-text-muted font-light leading-relaxed">
                    A transformative workshop experience connecting students and professionals through travel, culture, and global perspectives.
                </p>
            </div>
        </div>
    </div>

    <!-- Parallax image grid -->
    <div class="max-w-7xl mx-auto px-6">
        <!-- Row 1: 3 images -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
            {images.slice(0, 3).map((img, i) => (
                <div class="relative overflow-hidden rounded-xl group" data-reveal="clip">
                    <div class="aspect-[4/3]">
                        <img
                            src={img.src}
                            alt={img.alt}
                            class="w-full h-full object-cover parallax-img"
                            data-speed={0.08 + i * 0.02}
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                </div>
            ))}
        </div>

        <!-- Row 2: large left + 2 stacked right -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mt-4 md:mt-6">
            <div class="md:col-span-7 relative overflow-hidden rounded-xl group" data-reveal="clip">
                <div class="aspect-[3/4] md:aspect-[4/5]">
                    <img
                        src={images[3].src}
                        alt={images[3].alt}
                        class="w-full h-full object-cover parallax-img"
                        data-speed="0.08"
                    />
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <div class="absolute bottom-6 left-6 text-white opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-4 group-hover:translate-y-0">
                    <span class="text-[10px] uppercase tracking-[0.3em] font-semibold block mb-1">ISFiT 2025</span>
                    <span class="text-2xl font-bold" style="font-family: var(--font-serif);">Workshop Sessions</span>
                </div>
            </div>
            <div class="md:col-span-5 flex flex-col gap-4 md:gap-6">
                <div class="relative overflow-hidden rounded-xl group flex-1" data-reveal="clip">
                    <div class="aspect-[4/3]">
                        <img
                            src={images[4].src}
                            alt={images[4].alt}
                            class="w-full h-full object-cover parallax-img"
                            data-speed="0.12"
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                </div>
                <div class="relative overflow-hidden rounded-xl group flex-1" data-reveal="clip">
                    <div class="aspect-[4/3]">
                        <img
                            src={images[5].src}
                            alt={images[5].alt}
                            class="w-full h-full object-cover parallax-img"
                            data-speed="0.1"
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                </div>
            </div>
        </div>

        <!-- Row 3: 3 images -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mt-4 md:mt-6">
            {images.slice(6, 9).map((img, i) => (
                <div class="relative overflow-hidden rounded-xl group" data-reveal="clip">
                    <div class="aspect-[4/3]">
                        <img
                            src={img.src}
                            alt={img.alt}
                            class="w-full h-full object-cover parallax-img"
                            data-speed={0.06 + i * 0.03}
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                </div>
            ))}
        </div>

        <!-- Row 4: 3 images -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mt-4 md:mt-6">
            {images.slice(9, 12).map((img, i) => (
                <div class="relative overflow-hidden rounded-xl group" data-reveal="clip">
                    <div class="aspect-[4/3]">
                        <img
                            src={img.src}
                            alt={img.alt}
                            class="w-full h-full object-cover parallax-img"
                            data-speed={0.07 + i * 0.02}
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                </div>
            ))}
        </div>

        <!-- Row 5: 3 images -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mt-4 md:mt-6">
            {images.slice(12, 15).map((img, i) => (
                <div class="relative overflow-hidden rounded-xl group" data-reveal="clip">
                    <div class="aspect-[4/3]">
                        <img
                            src={img.src}
                            alt={img.alt}
                            class="w-full h-full object-cover parallax-img"
                            data-speed={0.09 + i * 0.01}
                        />
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <div class="absolute bottom-6 right-6 text-right text-white opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-4 group-hover:translate-y-0">
                        <span class="text-[10px] uppercase tracking-[0.3em] font-semibold block mb-1">Explore</span>
                        <a href="#contact" class="text-sm font-semibold border-b border-white/40 pb-0.5 hover:border-white transition-colors">Join Next Workshop &rarr;</a>
                    </div>
                </div>
            ))}
        </div>
    </div>

    <!-- Bottom text -->
    <div class="max-w-6xl mx-auto px-6 mt-16 md:mt-20">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <p class="text-xl md:text-2xl text-primary/70 font-light leading-relaxed" data-reveal="fade">
                Empowering the next generation of global leaders through immersive workshops and cross-cultural collaboration — <span class="serif-italic text-primary">where ideas meet the world.</span>
            </p>
            <div class="flex justify-start md:justify-end" data-reveal="fade">
                <a href="#contact" class="magnetic-btn inline-flex items-center gap-4 text-sm font-semibold uppercase tracking-wider group">
                    <span>Discover Travels</span>
                    <span class="w-12 h-px bg-primary group-hover:w-20 transition-all duration-500"></span>
                </a>
            </div>
        </div>
    </div>
</section>
