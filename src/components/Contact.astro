---
---

<section class="section-padding bg-background border-t border-accent/20" id="contact">
    <div class="max-w-editorial px-6 md:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24">
            <!-- Info -->
            <div class="lg:col-span-5 space-y-10 md:space-y-12">
                <div class="space-y-4 md:space-y-6">
                    <span class="text-[10px] uppercase tracking-[0.4em] text-text-muted font-semibold block">Get in Touch</span>
                    <h2 class="text-4xl md:text-6xl lg:text-7xl leading-[0.9] tracking-tight">
                        Let's Build Your <br /><span class="serif-italic text-accent-indigo">Legacy.</span>
                    </h2>
                    <p class="text-base md:text-lg text-text-muted font-light leading-relaxed max-w-sm">
                        Ready to take the next step in your global journey? Connect with our experts for a personalized consultation.
                    </p>
                </div>

                <div class="space-y-6 md:space-y-8">
                    <div class="group">
                        <p class="text-[10px] uppercase tracking-[0.3em] text-accent mb-2">Email</p>
                        <a href="mailto:info@motivprogroup.com" class="text-lg md:text-2xl font-light hover:text-accent-indigo transition-colors duration-300 inline-flex items-center gap-2">
                            info@motivprogroup.com
                            <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-2 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                        </a>
                    </div>

                    <div class="group">
                        <p class="text-[10px] uppercase tracking-[0.3em] text-accent mb-2">Location</p>
                        <p class="text-lg md:text-2xl font-light">Accra, Ghana</p>
                    </div>
                </div>
            </div>

            <!-- Form -->
            <div class="lg:col-span-7">
                <form class="bg-surface rounded-2xl p-8 md:p-10 shadow-lg shadow-primary/5 border border-accent/10 space-y-8">
                    <div class="grid md:grid-cols-2 gap-8">
                        <div class="group">
                            <label class="text-[10px] uppercase tracking-widest text-text-muted block mb-3 font-medium">Name</label>
                            <input
                                type="text"
                                placeholder="Your Name"
                                class="w-full bg-background border border-accent/20 rounded-xl px-4 py-3 text-sm font-light focus:ring-2 focus:ring-accent-indigo/30 focus:border-accent-indigo placeholder:text-accent/40 focus:outline-none transition-all duration-300"
                            />
                        </div>
                        <div class="group">
                            <label class="text-[10px] uppercase tracking-widest text-text-muted block mb-3 font-medium">Email</label>
                            <input
                                type="email"
                                placeholder="Your Email"
                                class="w-full bg-background border border-accent/20 rounded-xl px-4 py-3 text-sm font-light focus:ring-2 focus:ring-accent-indigo/30 focus:border-accent-indigo placeholder:text-accent/40 focus:outline-none transition-all duration-300"
                            />
                        </div>
                    </div>

                    <div class="group">
                        <label class="text-[10px] uppercase tracking-widest text-text-muted block mb-3 font-medium">Service</label>
                        <select class="w-full bg-background border border-accent/20 rounded-xl px-4 py-3 text-sm font-light focus:ring-2 focus:ring-accent-indigo/30 focus:border-accent-indigo appearance-none focus:outline-none transition-all duration-300 cursor-pointer">
                            <option>Educational Missions</option>
                            <option>Corporate Logistics</option>
                            <option>Travel Protocol</option>
                            <option>Consultation</option>
                        </select>
                    </div>

                    <div class="group">
                        <label class="text-[10px] uppercase tracking-widest text-text-muted block mb-3 font-medium">Message</label>
                        <textarea
                            rows="3"
                            placeholder="How can we help?"
                            class="w-full bg-background border border-accent/20 rounded-xl px-4 py-3 text-sm font-light focus:ring-2 focus:ring-accent-indigo/30 focus:border-accent-indigo resize-none placeholder:text-accent/40 focus:outline-none transition-all duration-300"
                        ></textarea>
                    </div>

                    <button
                        type="submit"
                        class="w-full bg-accent-indigo text-white px-8 py-4 rounded-full text-sm font-semibold tracking-wide transition-all duration-300 hover:shadow-lg hover:shadow-accent-indigo/25 hover:-translate-y-0.5 flex items-center justify-center gap-2 group"
                    >
                        Send Inquiry
                        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
