---
import heroImage from "../assets/hero-image.jpg";
---

<section
    class="relative min-h-screen flex flex-col overflow-hidden bg-primary"
    id="hero"
>
    <!-- Grain texture overlay -->
    <div class="absolute inset-0 z-[1] opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"></div>

    <!-- Background image -->
    <div class="absolute inset-0 z-0 overflow-hidden">
        <img
            src={heroImage.src}
            alt="Global Perspective"
            class="w-full h-full object-cover opacity-30"
        />
        <div
            class="absolute inset-0 bg-gradient-to-b from-primary/80 via-primary/60 to-primary"
        >
        </div>
        <!-- Subtle radial glow -->
        <div class="absolute inset-0 bg-radial-[ellipse_at_center] from-accent-indigo/10 to-transparent opacity-60"></div>
    </div>

    <!-- Content -->
    <div
        class="relative z-10 flex-1 flex items-center max-w-6xl mx-auto w-full px-6 py-32 md:py-40"
    >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center w-full">
            <!-- Left - Text content -->
            <div class="lg:col-span-7">
                <h1
                    class="text-4xl sm:text-5xl md:text-7xl lg:text-[5.5rem] font-bold leading-[0.92] mb-6 md:mb-8 tracking-tight text-white"
                >
                    <span class="block">Your Global Journey</span>
                    <span class="block">Starts With a</span>
                    <span class="block"
                        ><span class="serif-italic text-accent-indigo">Conversation.</span></span
                    >
                </h1>

                <p
                    class="text-lg md:text-xl text-white/50 max-w-xl mb-10 leading-relaxed font-light"
                >
                    Book a free consultation and let our experts craft a tailored plan for
                    your education, scholarship, or travel goals.
                </p>

                <div class="flex flex-wrap items-center gap-4">
                    <a
                        href="/consultation"
                        class="group bg-accent-indigo text-white px-10 py-5 rounded-full text-base font-bold tracking-wide inline-flex items-center gap-3 transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-accent-indigo/30"
                    >
                        Book a Consultation
                        <svg
                            class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2.5"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                        >
                    </a>
                    <a
                        href="/#services"
                        class="inline-flex items-center gap-2 text-white/60 hover:text-white text-sm font-medium transition-all duration-300 group"
                    >
                        Explore Services
                        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </a>
                </div>
            </div>

            <!-- Right - ISFIT Banner -->
            <div class="lg:col-span-5 flex justify-center lg:justify-end">
                <img
                    src="/banners/isfit_partnership_banner.jpeg"
                    alt="ISFIT Partnership"
                    class="max-h-[400px] lg:max-h-[500px] w-auto object-contain rounded-2xl shadow-2xl shadow-black/20"
                />
            </div>
        </div>
    </div>

    <!-- Scroll indicator -->
    <div
        class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-3"
    >
        <span class="text-[9px] uppercase tracking-[0.3em] text-white/20"
            >Scroll</span
        >
        <div
            class="w-px h-12 bg-gradient-to-b from-white/20 to-transparent"
        >
        </div>
    </div>
</section>
