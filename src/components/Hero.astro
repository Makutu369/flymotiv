---
import heroImage from "../assets/hero-image.jpg";
---

<section
    class="relative min-h-screen flex flex-col overflow-hidden bg-primary"
    id="hero"
>
    <!-- Background parallax image -->
    <div class="absolute inset-0 z-0 overflow-hidden">
        <img
            src={heroImage.src}
            alt="Global Perspective"
            class="w-full h-[120%] object-cover parallax-img opacity-30"
            data-speed="0.15"
        />
        <div
            class="absolute inset-0 bg-gradient-to-b from-primary/70 via-primary/50 to-primary"
        >
        </div>
    </div>

    <!-- Content -->
    <div
        class="relative z-10 flex-1 flex flex-col justify-center max-w-6xl mx-auto w-full px-6 py-32 md:py-40"
    >
        <span
            class="inline-block text-[10px] uppercase tracking-[0.4em] text-white/40 font-semibold mb-8"
            data-hero
        >
            Ghana to the World
        </span>

        <h1
            class="text-4xl sm:text-5xl md:text-7xl lg:text-[5.5rem] font-bold leading-[0.92] mb-6 md:mb-8 tracking-tight text-white max-w-4xl"
        >
            <span class="block" data-hero>Your Global Journey</span>
            <span class="block" data-hero>Starts With a</span>
            <span class="block" data-hero
                ><span class="serif-italic text-accent-orange">Conversation.</span></span
            >
        </h1>

        <p
            class="text-lg md:text-xl text-white/50 max-w-xl mb-10 leading-relaxed font-light"
            data-hero
        >
            Book a free consultation and let our experts craft a tailored plan for
            your education, scholarship, or travel goals.
        </p>

        <div data-hero>
            <a
                href="/consultation"
                class="magnetic-btn group cta-pulse bg-accent-orange text-white px-10 py-5 rounded-full text-base font-bold tracking-wide inline-flex items-center gap-3 transition-all duration-300 hover:scale-105 hover:shadow-2xl hover:shadow-accent-orange/30"
            >
                Book a Consultation
                <svg
                    class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                >
            </a>
        </div>

    <!-- Scroll indicator -->
    <div
        class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-3"
        data-hero
    >
        <span class="text-[9px] uppercase tracking-[0.3em] text-white/20"
            >Scroll</span
        >
        <div
            class="w-px h-12 bg-gradient-to-b from-black/30 to-transparent relative overflow-hidden"
        >
            <div
                class="absolute top-0 left-0 w-full h-1/2 bg-white"
                style="animation: scrollLine 1.5s ease-in-out infinite;"
            >
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes scrollLine {
        0% {
            transform: translateY(-100%);
        }
        100% {
            transform: translateY(200%);
        }
    }

    .cta-pulse {
        position: relative;
        box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.4);
        animation: ctaPulse 2.5s ease-in-out infinite;
    }

    .cta-pulse:hover {
        animation: none;
    }

    @keyframes ctaPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.35), 0 4px 20px rgba(79, 70, 229, 0.2);
        }
        50% {
            box-shadow: 0 0 0 12px rgba(79, 70, 229, 0), 0 4px 20px rgba(79, 70, 229, 0.2);
        }
    }
</style>
